# --- C# / .NET / Visual Studio ---

# Build Artifacts & Output
# This is the most important section to prevent committing compiled code.
[Bb]in/
[Oo]bj/
publish/

# NuGet package restore files
*.nupkg
packages/

# User-specific files & IDE settings
# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
# JetBrains Rider
.idea/

# Test Results & Coverage
TestResults/
*.trx
*.coverlet.json

# Cache, logs, and local databases
*.cache
*.log
*.bak
*.sqlite

# Runtime-generated files
*.vshost.*
*.dotCover

# --- OS-specific files ---
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# --- Environment & Secret files ---
# Never commit secrets or local environment variables!
*.env
secrets.json
appsettings.Development.json
appsettings.json
appsettings.*.json
Secrets/